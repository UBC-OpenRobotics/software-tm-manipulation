<?xml version='1.0'?>
<sdf version='1.7'>
  <model name="VisionKit">
    <pose>0 0 0 0 0 0 0</pose>
    <link name="stand">
      <visual name="stand_visual">
        <pose>0 0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://VisionKit/stand.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>
      <collision name="stand_collision">
        <pose>0 0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://VisionKit/stand.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>
    </link>
    <link name="camera">
      <visual name="camera_visual">
        <pose>-0.056011 0.016227 0.274459 0 -0.785397 0</pose>
        <geometry>
          <mesh>
            <uri>model://RealSenseD415/camera.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <script>
            <name>Gazebo/Red</name>
          </script>
        </material>
      </visual>
      <collision name="camera_collision">
        <pose>0 0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://RealSenseD415/camera.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </collision>

      <!-- Camera Sensor -->
      <sensor name="camera_sensor" type="camera">
        <pose>-0.056011 0.016227 0.274459 0 0.9 3.1416</pose>  <!-- Adjust based on camera position 0 0.9 3.1416 -->
        <!-- <visualize>true</visualize> -->
        <update_rate>30</update_rate> <!-- 30 FPS -->
        <camera>
          <horizontal_fov>1.396</horizontal_fov> <!-- Field of view in radians -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format> <!-- RGB format -->
          </image>
          <clip>
            <near>0.05</near>
            <far>5.0</far>
          </clip>
        </camera>

        <!-- Gazebo Plugin for the Camera -->
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
          <always_on>true</always_on>
          <update_rate>30</update_rate>
          <camera_name>camera</camera_name>
          <image_topic_name>/camera/image_raw</image_topic_name>
          <camera_info_topic_name>/camera/camera_info</camera_info_topic_name>
          <frame_name>camera</frame_name>
        </plugin>
      </sensor>

      <!-- depth camera Sensor -->
      <sensor name="camera_sensor" type="depth">
        <pose>-0.056011 0.016227 0.274459 0 0.9 3.1416</pose>  <!-- Adjust based on camera position 0 0.9 3.1416 -->
        <visualize>true</visualize>
        <update_rate>30</update_rate> <!-- 30 FPS -->
        <camera>
          <horizontal_fov>1.396</horizontal_fov> <!-- Field of view in radians -->
          <image>
            <width>640</width>
            <height>480</height>
            <format>R8G8B8</format> <!-- RGB format -->
          </image>
          <clip>
            <near>0.05</near>
            <far>5.0</far>
          </clip>
        </camera>

        <!-- Gazebo Plugin for the depth Camera -->
        <plugin name="depth_camera_controller" filename="libgazebo_ros_caemra.so">
          <!-- <frameName>world</frameName> -->
          <!-- <frame_id>world</frame_id> -->
          <min_depth>0.001</min_depth>
          <max_depth>100.0</max_depth>
        </plugin>
      </sensor>

    </link>
    <static>1</static>
  </model>
</sdf>
